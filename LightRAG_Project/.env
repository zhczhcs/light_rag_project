# 阿里百炼 (DashScope) 配置
# 这里的 Key 通常以 "sk-" 开头
ALI_API_KEY=YOUR_API_KEY_PLACEHOLDER

# 阿里百炼兼容 OpenAI 的接口地址 (这是官方提供的兼容地址)
ALI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型选择 (推荐 qwen-plus 或 qwen-max，性价比高且强)
LLM_MODEL=qwen-plus-2025-12-01

# 向量模型 (阿里官方推荐 text-embedding-v2 或 text-embedding-v4)
EMBEDDING_MODEL=text-embedding-v4