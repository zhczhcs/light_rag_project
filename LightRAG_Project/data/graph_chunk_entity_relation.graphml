  <data key="d13"></data>
</edge>
<edge source="Semiconductor" target="Intrinsic Semiconductor">
  <data key="d7">1.0</data>
  <data key="d8">An intrinsic semiconductor is a pure form of a semiconductor, which behaves as an insulator at absolute zero and its conductivity increases with temperature.</data>
