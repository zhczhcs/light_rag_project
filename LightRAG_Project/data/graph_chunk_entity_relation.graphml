  <data key="d0">Bipolar Junction Transistor (BJT)</data>
  <data key="d1">artifact</data>
  <data key="d2">A three-terminal electronic component with current amplification capabilities, used in amplifying and switching circuits.</data>
  <data key="d3">chunk-4ec8b1d356971d5996696430fb70aa33</data>
  <data key="d4">半导体材料介绍.txt</data>
