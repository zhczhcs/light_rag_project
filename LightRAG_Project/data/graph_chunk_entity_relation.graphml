</node>
<node id="Wafer">
  <data key="d0">Wafer</data>
  <data key="d1">artifact</data>
  <data key="d2">A wafer is a thin slice of silicon, cut from a single crystal silicon ingot, used as the base material for semiconductor manufacturing.</data>
  <data key="d3">chunk-ae080121232af020ad6ba3a6ec2d7d3f</data>
  <data key="d4">半导体材料介绍.txt</data>
  <data key="d5">1770982432</data>
  <data key="d6"></data>
</node>
<node id="Oxidation">
  <data key="d0">Oxidation</data>
  <data key="d1">method</data>
  <data key="d2">Oxidation is a process in semiconductor manufacturing where a protective layer of silicon dioxide is formed on the surface of the wafer.</data>
  <data key="d3">chunk-ae080121232af020ad6ba3a6ec2d7d3f&lt;SEP&gt;chunk-8ef94f588ef70d0bd8967e7353481a56</data>
  <data key="d4">半导体材料介绍.txt</data>
  <data key="d5">1770982433</data>
  <data key="d6"></data>
</node>
<node id="Lithography">
  <data key="d0">Lithography</data>
  <data key="d1">method</data>
  <data key="d2">Lithography is a critical step in semiconductor manufacturing that uses photoresist and a mask to transfer circuit patterns onto the wafer surface.</data>
  <data key="d3">chunk-ae080121232af020ad6ba3a6ec2d7d3f</data>
  <data key="d4">半导体材料介绍.txt</data>
  <data key="d5">1770982433</data>
  <data key="d6"></data>
</node>
<node id="Etching">
  <data key="d0">Etching</data>
  <data key="d1">method</data>
  <data key="d2">Etching is a process in semiconductor manufacturing that removes unwanted oxide or metal layers from the wafer.&lt;SEP&gt;Etching is a process used to remove material from the wafer to create the desired circuit structures.</data>
  <data key="d3">chunk-ae080121232af020ad6ba3a6ec2d7d3f&lt;SEP&gt;chunk-8ef94f588ef70d0bd8967e7353481a56</data>
  <data key="d4">半导体材料介绍.txt&lt;SEP&gt;集成电路制造工艺.txt</data>
