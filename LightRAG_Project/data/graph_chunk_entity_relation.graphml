</node>
<node id="Gallium Arsenide">
  <data key="d0">Gallium Arsenide</data>
  <data key="d1">material</data>
  <data key="d2">A second-generation semiconductor material with high electron mobility, suitable for high-frequency and high-speed applications such as satellite communication and radar.</data>
  <data key="d3">chunk-4ec8b1d356971d5996696430fb70aa33</data>
