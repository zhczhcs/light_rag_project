<node id="Semiconductor">
  <data key="d0">Semiconductor</data>
  <data key="d1">concept</data>
  <data key="d2">A material with electrical conductivity between that of a conductor and an insulator, widely used in electronics such as computers, mobile phones, and digital recorders. Common semiconductor materials include silicon, germanium, and gallium arsenide.</data>
  <data key="d3">chunk-4ec8b1d356971d5996696430fb70aa33</data>
  <data key="d4">半导体材料介绍.txt</data>
  <data key="d5">1770982430</data>
  <data key="d6"></data>
</node>
<node id="Valence Band">
  <data key="d0">Valence Band</data>
  <data key="d1">concept</data>
  <data key="d2">The energy band in a semiconductor that is filled with electrons at absolute zero temperature.</data>
  <data key="d3">chunk-4ec8b1d356971d5996696430fb70aa33</data>
  <data key="d4">半导体材料介绍.txt</data>
  <data key="d5">1770982430</data>
  <data key="d6"></data>
</node>
<node id="Conduction Band">
  <data key="d0">Conduction Band</data>
  <data key="d1">concept</data>
  <data key="d2">The energy band in a semiconductor where electrons can move freely and conduct electricity.</data>
  <data key="d3">chunk-4ec8b1d356971d5996696430fb70aa33</data>
  <data key="d4">半导体材料介绍.txt</data>
  <data key="d5">1770982430</data>
  <data key="d6"></data>
</node>
<node id="Band Gap">
  <data key="d0">Band Gap</data>
  <data key="d1">concept</data>
  <data key="d2">The energy gap between the valence band and the conduction band in a semiconductor.</data>
  <data key="d3">chunk-4ec8b1d356971d5996696430fb70aa33</data>
  <data key="d4">半导体材料介绍.txt</data>
  <data key="d5">1770982430</data>
  <data key="d6"></data>
</node>
<node id="Intrinsic Semiconductor">
  <data key="d0">Intrinsic Semiconductor</data>
  <data key="d1">concept</data>
  <data key="d2">A pure semiconductor crystal without any impurities or lattice defects, which behaves as an insulator at absolute zero and its conductivity increases with temperature.</data>
  <data key="d3">chunk-4ec8b1d356971d5996696430fb70aa33</data>
  <data key="d4">半导体材料介绍.txt</data>
  <data key="d5">1770982430</data>
  <data key="d6"></data>
</node>
<node id="Doping">
  <data key="d0">Doping</data>
  <data key="d1">method</data>
  <data key="d2">The process of intentionally introducing impurities into a pure semiconductor to alter its electrical properties, significantly changing its conductivity.</data>
  <data key="d3">chunk-4ec8b1d356971d5996696430fb70aa33</data>
  <data key="d4">半导体材料介绍.txt</data>
  <data key="d5">1770982430</data>
  <data key="d6"></data>
</node>
<node id="Carrier">
  <data key="d0">Carrier</data>
  <data key="d1">concept</data>
  <data key="d2">Particles in a semiconductor responsible for charge transport, including electrons and holes.</data>
  <data key="d3">chunk-4ec8b1d356971d5996696430fb70aa33</data>
  <data key="d4">半导体材料介绍.txt</data>
  <data key="d5">1770982430</data>
  <data key="d6"></data>
</node>
<node id="Electron">
  <data key="d0">Electron</data>
  <data key="d1">naturalobject</data>
  <data key="d2">A negatively charged particle located in the conduction band of a semiconductor.</data>
  <data key="d3">chunk-4ec8b1d356971d5996696430fb70aa33</data>
  <data key="d4">半导体材料介绍.txt</data>
  <data key="d5">1770982430</data>
  <data key="d6"></data>
</node>
<node id="Hole">
  <data key="d0">Hole</data>
  <data key="d1">naturalobject</data>
  <data key="d2">A positively charged "virtual particle" located in the valence band, representing the absence of an electron.</data>
  <data key="d3">chunk-4ec8b1d356971d5996696430fb70aa33</data>
  <data key="d4">半导体材料介绍.txt</data>
  <data key="d5">1770982431</data>
  <data key="d6"></data>
</node>
<node id="N-Type Semiconductor">
  <data key="d0">N-Type Semiconductor</data>
  <data key="d1">concept</data>
  <data key="d2">A type of doped semiconductor where 5-valent elements (such as phosphorus or arsenic) are added to a 4-valent element (like silicon), making electrons the majority carriers and holes the minority carriers.</data>
  <data key="d3">chunk-4ec8b1d356971d5996696430fb70aa33</data>
  <data key="d4">半导体材料介绍.txt</data>
  <data key="d5">1770982431</data>
  <data key="d6"></data>
</node>
<node id="P-Type Semiconductor">
  <data key="d0">P-Type Semiconductor</data>
  <data key="d1">concept</data>
  <data key="d2">A type of doped semiconductor where 3-valent elements (such as boron or indium) are added to a 4-valent element, making holes the majority carriers and electrons the minority carriers.</data>
  <data key="d3">chunk-4ec8b1d356971d5996696430fb70aa33</data>
  <data key="d4">半导体材料介绍.txt</data>
  <data key="d5">1770982431</data>
  <data key="d6"></data>
</node>
<node id="PN Junction">
  <data key="d0">PN Junction</data>
  <data key="d1">concept</data>
  <data key="d2">A special region formed at the interface between P-type and N-type semiconductors, which has unidirectional conductivity and is the basis for diodes and transistors.</data>
  <data key="d3">chunk-4ec8b1d356971d5996696430fb70aa33</data>
  <data key="d4">半导体材料介绍.txt</data>
  <data key="d5">1770982431</data>
  <data key="d6"></data>
</node>
<node id="Silicon">
  <data key="d0">Silicon</data>
  <data key="d1">material</data>
  <data key="d2">A first-generation semiconductor material, widely used in CPUs, memory, and logic devices due to its mature technology and low cost.</data>
  <data key="d3">chunk-4ec8b1d356971d5996696430fb70aa33</data>
  <data key="d4">半导体材料介绍.txt</data>
