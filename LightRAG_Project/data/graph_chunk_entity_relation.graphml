</node>
<node id="Indium Phosphide">
  <data key="d0">Indium Phosphide</data>
  <data key="d1">material</data>
  <data key="d2">A second-generation semiconductor material, also used in high-frequency and high-speed applications.</data>
  <data key="d3">chunk-4ec8b1d356971d5996696430fb70aa33</data>
  <data key="d4">半导体材料介绍.txt</data>
  <data key="d5">1770982431</data>
  <data key="d6"></data>
</node>
<node id="Silicon Carbide">
  <data key="d0">Silicon Carbide</data>
  <data key="d1">material</data>
  <data key="d2">A third-generation semiconductor material with a wide bandgap, high breakdown electric field, and high thermal conductivity, suitable for high-temperature, high-frequency, and high-power devices.</data>
  <data key="d3">chunk-4ec8b1d356971d5996696430fb70aa33</data>
  <data key="d4">半导体材料介绍.txt</data>
  <data key="d5">1770982432</data>
  <data key="d6"></data>
</node>
<node id="Gallium Nitride">
  <data key="d0">Gallium Nitride</data>
  <data key="d1">material</data>
  <data key="d2">A third-generation semiconductor material, also with a wide bandgap and high thermal conductivity, used in high-temperature, high-frequency, and high-power devices.</data>
  <data key="d3">chunk-4ec8b1d356971d5996696430fb70aa33</data>
  <data key="d4">半导体材料介绍.txt</data>
  <data key="d5">1770982432</data>
  <data key="d6"></data>
</node>
<node id="Diode">
  <data key="d0">Diode</data>
  <data key="d1">artifact</data>
  <data key="d2">A diode is a semiconductor device that uses the unidirectional conductivity of a PN junction for rectification, detection, and voltage regulation.&lt;SEP&gt;An electronic component that uses the unidirectional conductivity of a PN junction for rectification, detection, and voltage regulation.</data>
  <data key="d3">chunk-4ec8b1d356971d5996696430fb70aa33&lt;SEP&gt;chunk-ae080121232af020ad6ba3a6ec2d7d3f</data>
